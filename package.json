    "eslint-plugin-promise": "^6.1.1",
    "express": "^4.18.2",
    "husky": "^8.0.3",
    "jest": "^29.4.3",
    "lint-staged": "^15.2.2",
    "prettier": "2.8.4",
    "rimraf": "^4.1.2",
    "ts-jest": "^29.0.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "4.9.5"
