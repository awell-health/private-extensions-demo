{
  "name": "@awell-health/private-extensions-demo",
  "version": "1.0.9",
  "packageManager": "yarn@3.4.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
