    "@graphql-codegen/typescript-operations": "^4.0.1",
    "@graphql-tools/apollo-engine-loader": "8.0.0",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.14.191",
    "@types/node": "^20.11.24",
    "@types/node-fetch": "^2.6.2",
    "@typescript-eslint/eslint-plugin": "^5.52.0",
    "body-parser": "^1.20.2",
