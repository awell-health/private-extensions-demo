{
  "name": "@awell-health/private-extensions-demo",
  "version": "1.0.30",
  "packageManager": "yarn@4.9.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awell-health/private-extensions-demo.git"
  },
  "bugs": {
    "url": "https://github.com/awell-health/private-extensions-demo/issues"
  },
  "homepage": "https://github.com/awell-health/private-extensions-demo#readme",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "format": "prettier --write \"./src/**/*.ts\"",
    "lint": "eslint \"./src/**/*.ts\"",
    "postinstall": "husky install",
    "test": "NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\" jest"
  },
  "files": [
    "dist",
    "!**/*.test.ts",
    "!**/__tests__/**",
    "!**/__mocks__/**"
  ],
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.2",
    "eslint-config-standard-with-typescript": "^34.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^15.7.0",
    "eslint-plugin-promise": "^6.6.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "rimraf": "^4.4.1",
    "ts-jest": "~29.3.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@awell-health/extensions-core": "^1.1.19"
  }
}
